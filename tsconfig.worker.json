{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": [
    "worker/**/*.ts",
    "lib/**/*.ts",
    "models/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "app/**/*",
    "components/**/*",
    ".next/**/*"
  ]
}
