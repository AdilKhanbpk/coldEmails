// Prisma schema for the AI Outreach Platform.
// MongoDB is the database. This file is used by Prisma's client generator
// and `prisma db push` to keep the database collections in sync.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id                  String    @id @default(cuid()) @map("_id")
  name                String
  email               String    @unique
  password            String? // nullable for OAuth-only users
  businessName        String?
  businessDescription String?
  services            String[] // list of services offered
  role                String    @default("ADMIN")
  plan                String    @default("FREE")
  status              String    @default("ACTIVE")
  calendarConnected   Boolean   @default(false)
  calendarProvider    String? // "google" | "outlook" | null
  calendarCredentials String? // encrypted JSON blob
  aiPaused            Boolean   @default(false) // global pause-all-AI toggle
  stripeCustomerId    String?
  stripeSubscriptionId String?
  createdAt           DateTime  @default(now())

  outreachTypes  OutreachType[]
  leads          UserLead[]
  conversations  Conversation[]
  messages       Message[]
  meetings       Meeting[]
  jobs           Job[]
  notifications  Notification[]
  inboxes        Inbox[]
}

model OutreachType {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  name          String
  systemPrompt  String
  exampleEmails String[] // expects exactly 4 strings
  sequenceSteps Json    // [{ stepNumber, delayDays }]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads UserLead[]

  @@index([userId])
}

model UserLead {
  id                   String   @id @default(cuid()) @map("_id")
  userId               String
  companyName          String
  email                String
  services             String[]
  country              String
  website              String?
  outreachTypeId       String?
  outreachDescription  String
  preferredTime        DateTime
  timezone             String
  currentStep          Int      @default(0)
  status               String   @default("NOT_STARTED")
  replyTag             String?
  aiEnabled            Boolean  @default(true)
  source               String   @default("MANUAL")
  lastMessageDate      DateTime?
  nextMessageDate      DateTime?
  openedAt             DateTime?
  clickedAt            DateTime?
  createdAt            DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreachType  OutreachType? @relation(fields: [outreachTypeId], references: [id], onDelete: SetNull)
  conversation  Conversation?
  messages      Message[]
  meetings      Meeting[]
  jobs          Job[]

  @@index([userId])
  @@index([status])
  @@index([outreachTypeId])
}

model Conversation {
  id           String    @id @default(cuid()) @map("_id")
  leadId       String    @unique
  userId       String
  aiEnabled    Boolean   @default(true)
  status       String    @default("ACTIVE")
  lastActivity DateTime?
  createdAt    DateTime  @default(now())

  lead     UserLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  meetings Meeting[]

  @@index([userId])
  @@index([status])
}

model Message {
  id                String   @id @default(cuid()) @map("_id")
  conversationId    String
  leadId            String
  userId            String
  role              String
  content           String
  subject           String?
  step              Int?
  aiGenerated       Boolean  @default(false)
  senderEmail       String?
  providerMessageId String?
  threadId          String?
  status            String   @default("SENT")
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         UserLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
}

model Meeting {
  id              String   @id @default(cuid()) @map("_id")
  conversationId  String
  leadId          String
  userId          String
  customerName    String
  customerEmail   String
  scheduledTime   DateTime
  timezone        String
  meetingProvider String
  meetingLink     String?
  proposedSlots   Json?
  status          String   @default("PROPOSED")
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  lead         UserLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([leadId])
  @@index([userId])
  @@index([status])
}

model Job {
  id              String   @id @default(cuid()) @map("_id")
  leadId          String
  userId          String
  type            String
  runAt           DateTime
  status          String   @default("SCHEDULED")
  attempts        Int      @default(0)
  schedulerJobId  String?
  createdAt       DateTime @default(now())

  lead UserLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([userId])
  @@index([status])
  @@index([runAt])
}

model Inbox {
  id              String   @id @default(cuid()) @map("_id")
  userId          String
  provider        String   @default("GMAIL")
  emailAddress    String
  credentials     String // AES-256-GCM encrypted JSON blob
  status          String   @default("CONNECTED")
  dailySendingCap Int      @default(50)
  warmupThrottle  Boolean  @default(false)
  sentToday       Int      @default(0)
  sentDate        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  type      String
  message   String
  leadId    String?
  seen      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([seen])
}

model TeamInvitation {
  id              String   @id @default(cuid()) @map("_id")
  email           String
  role            String   @default("MEMBER")
  inviterId       String
  organizationId String
  token           String   @unique
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([organizationId])
}

model ActivityLog {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}
